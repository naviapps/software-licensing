<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NaviApps.SoftwareLicensing</PackageId>
    <Version>0.1.0</Version>
    <Description>Rust-backed license lifecycle, transactional persistence and recovery.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SdkNativeRuntimeAssets Condition="'$(SdkNativeRuntimeAssets)' == ''">$(SoftwareLicensingNativeAssets)</SdkNativeRuntimeAssets>
    <IsPackable Condition="'$(SdkNativeRuntimeAssets)' == ''">false</IsPackable>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SdkNativeRuntimeAssets)/**/*" Condition="'$(SdkNativeRuntimeAssets)' != ''"
          Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(SoftwareLicensingNativeLibrary)" Condition="'$(SoftwareLicensingNativeLibrary)' != ''"
          CopyToOutputDirectory="Always" Pack="false">
      <Link Condition="'$(OS)' == 'Windows_NT'">software_licensing.dll</Link>
      <Link Condition="'$(OS)' != 'Windows_NT'">libsoftware_licensing.dylib</Link>
    </None>
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../../ThirdParty/**/*" Exclude="../../../../ThirdParty/**/.DS_Store;../../../../ThirdParty/**/registry-notices.json" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/software-licensing/dotnet/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
</Project>
